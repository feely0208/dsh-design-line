{
  "name": "@deepwhale-cn/dsh-design-line",
  "version": "0.1.3",
  "description": "深鲸工序 · 设计插件线：PS / AutoCAD / 3ds Max / Blender 四条完整工序流水线（意图→工序→落盘审阅→执行→校验→回执），也是框架 —— 写一个适配器就能接入新软件",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "design",
    "photoshop",
    "autocad",
    "3dsmax",
    "workflow",
    "工序",
    "设计师"
  ],
  "files": [
    "lib",
    "bin",
    "skill",
    "内核",
    "适配器",
    "流水线",
    "回执模块",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "契约",
    "模板"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "bin": {
    "dsh-design-line": "./bin/cli.mjs"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "homepage": "https://www.deepwhale.org.cn/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-design-line.git"
  }
}